{
  "locales": ["en", "it"],
  "vectors": [
    { "name": "nothing sent", "cookie": null, "acceptLanguage": null, "expect": "en" },
    { "name": "empty strings", "cookie": "", "acceptLanguage": "", "expect": "en" },
    { "name": "italian browser", "cookie": null, "acceptLanguage": "it", "expect": "it" },
    { "name": "region is stripped", "cookie": null, "acceptLanguage": "it-IT,it;q=0.9,en;q=0.8", "expect": "it" },
    { "name": "english first wins", "cookie": null, "acceptLanguage": "en-US,en;q=0.9,it;q=0.8", "expect": "en" },
    { "name": "q-values reorder", "cookie": null, "acceptLanguage": "en;q=0.4,it;q=0.9", "expect": "it" },
    { "name": "equal q keeps header order", "cookie": null, "acceptLanguage": "it;q=0.5,en;q=0.5", "expect": "it" },
    { "name": "q=0 is refused", "cookie": null, "acceptLanguage": "it;q=0,en", "expect": "en" },
    { "name": "unregistered language falls through to a registered one", "cookie": null, "acceptLanguage": "fr-FR,fr;q=0.9,it;q=0.5", "expect": "it" },
    { "name": "only unregistered languages", "cookie": null, "acceptLanguage": "fr-FR,de;q=0.8", "expect": "en" },
    { "name": "wildcard is ignored", "cookie": null, "acceptLanguage": "*", "expect": "en" },
    { "name": "case is ignored", "cookie": null, "acceptLanguage": "IT-it", "expect": "it" },
    { "name": "script subtag is stripped", "cookie": null, "acceptLanguage": "it-Latn-IT", "expect": "it" },
    { "name": "garbage q does not throw", "cookie": null, "acceptLanguage": "it;q=abc,en;q=0.5", "expect": "en" },
    { "name": "garbage header", "cookie": null, "acceptLanguage": ";;;,,,q=1", "expect": "en" },
    { "name": "cookie wins over Accept-Language", "cookie": "rb_locale=it", "acceptLanguage": "en-US,en;q=0.9", "expect": "it" },
    { "name": "cookie en wins over an italian browser", "cookie": "rb_locale=en", "acceptLanguage": "it-IT,it;q=0.9", "expect": "en" },
    { "name": "cookie among others", "cookie": "a=1; rb_locale=it; reelbolt_user=x", "acceptLanguage": "en", "expect": "it" },
    { "name": "unregistered cookie is ignored", "cookie": "rb_locale=fr", "acceptLanguage": "it", "expect": "it" },
    { "name": "crafted cookie is ignored", "cookie": "rb_locale=../../etc/passwd", "acceptLanguage": null, "expect": "en" },
    { "name": "cookie name must match exactly", "cookie": "xrb_locale=it", "acceptLanguage": null, "expect": "en" },
    { "name": "cookie value case is folded", "cookie": "rb_locale=IT", "acceptLanguage": null, "expect": "it" },
    { "name": "malformed percent-encoding does not throw", "cookie": "rb_locale=%E0%A4%A", "acceptLanguage": "it", "expect": "it" }
  ],
  "threeLocales": {
    "locales": ["en", "it", "fr"],
    "vectors": [
      { "name": "a newly registered language is picked", "cookie": null, "acceptLanguage": "fr-CA,fr;q=0.9", "expect": "fr" },
      { "name": "default stays the first registered code", "cookie": null, "acceptLanguage": "de", "expect": "en" }
    ]
  }
}
