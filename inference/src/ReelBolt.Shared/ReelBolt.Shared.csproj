<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by sandbox/scripts/generate-fonts.py at one pinned google/fonts commit; read by GoogleFontCatalog. -->
    <EmbeddedResource Include="DesignSystems\Data\google-fonts-catalog.json" LogicalName="ReelBolt.Shared.DesignSystems.google-fonts-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- Same version both hosts resolve through Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 (Data/PostgresDatabaseBootstrap.cs). -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <!-- Same version the engine's ExpressionEvaluator uses: StaticBranchResolver decides input-only conditions with it (docs/design/app-inputs.md 9.3). -->
    <PackageReference Include="NCalcSync" Version="7.2.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.24.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <!--
      These five move together. Microsoft.Agents.AI.* pulls Microsoft.Extensions.AI.Abstractions
      and OpenAI transitively, and the family is only safe at versions compiled against the SAME
      Abstractions — a mismatch is invisible to the compiler and throws TypeLoadException on the
      first agent run (see docs/anthropic-provider.md for the incident that established this).

      Resolved set (project.assets.json, identical in Shared, Inference.Api and WorkflowEngine):
        Microsoft.Agents.AI.* 1.24.0  -> Microsoft.Extensions.AI 10.10.0, .Abstractions 10.10.1,
                                         .OpenAI 10.10.1, OpenAI 2.14.0 (per its nuspec)
        Microsoft.Extensions.AI.OpenAI 10.10.1 -> exactly OpenAI 2.14.0; the 10.10.0 build referenced
                                         OpenAI.Responses.GlobalMcpToolCallApprovalPolicy, which 2.14.0
                                         removes, and 10.10.1 no longer does (that was the old blocker)
        Azure.AI.OpenAI 2.9.0-beta.1  -> built against OpenAI 2.9.1, unifies upward to 2.14.0
        Anthropic 12.55.0             -> Abstractions 10.5.1, unifies up to 10.10.1
        OpenAI 2.14.0                 -> still carries ChatCompletionOptions.ReasoningEffortLevel with
                                         its implicit conversion from string, which RoomSeatAgent's
                                         out-of-vocabulary reasoning-effort fallback relies on

      Azure.AI.OpenAI is the laggard (2.9.0-beta.1 is the newest published) and is therefore the
      thing most likely to block the next bump of this set. Re-run the type/member reference scan
      against whatever OpenAI version the new Microsoft.Agents.AI wants before assuming it is fine.
    -->
    <PackageReference Include="Anthropic" Version="12.55.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="AWSSDK.S3" Version="4.1.2.1" />
    <!-- Same AWSSDK 4.x family as AWSSDK.S3; wraps the Data Protection key ring (docs/design/cloud-provider-adr.md). -->
    <PackageReference Include="AWSSDK.KeyManagementService" Version="4.0.100.17" />
    <!-- IXmlRepository / KeyManagementOptions live in the full DataProtection assembly (shared framework). -->
    <!-- OpenTelemetry (WP F9): only OpenTelemetry.* packages; the Microsoft.Extensions.AI.* set above is unaffected. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.19.1-beta.1" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
