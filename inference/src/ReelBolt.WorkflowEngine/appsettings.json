{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=reelforge;Username=postgres;Password=postgres"
  },
  "Database": {
    "MigrateAtStartup": true
  },
  "Jwt": {
    "Issuer": "reelbolt-api",
    "Audience": "reelbolt-inference",
    "SigningKey": ""
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "DeploymentName": "gpt-4o-mini",
    "ApiKey": ""
  },
  "DataProtection": {
    "KeysPath": "/keys"
  },
  "Inference": {
    "ProviderCacheSeconds": 60
  },
  "VideoEditing": {
    "ScratchPath": "/var/tmp/reelbolt-video",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "MaxConcurrentJobs": 1,
    "AnalyzeTimeoutSeconds": 900,
    "CompileTimeoutSeconds": 1800,
    "WatermarkAssetPath": "/app/assets/watermark.png"
  },
  "VideoEnhance": {
    "Local": {
      "TimeoutSeconds": 1800,
      "MaxSourceSeconds": 600
    }
  },
  "VideoGeneration": {
    "GlobalDailyBudgetCredits": 833333.33333333333333333333333,
    "DailyGpuMinutes": 120.0,
    "GlobalDailyGpuMinutes": 240.0,
    "MaxConcurrentPerProvider": 2
  },
  "Compute": {
    // D6: where the engine gets its compute from. The key is deliberately ABSENT here: the shipped
    // value is ComputeOptions.Mode's own default, Local, and that is the whole self-host story
    // (docs/design/runner-protocol-adr.md section 1). With Local nothing below except
    // OutputVerification is read, no gateway is called and no organization row is consulted, so an
    // existing install needs no new configuration. Set Compute:Mode to Fabric to make the selector
    // resolve a target per step - the organization's own paired runner, or our worker pool.
    // The Go runner-gateway's cluster-internal API (WP D5a/D5b). Never published; reachable only on
    // the compose network or in the cluster. InternalToken is the shared service token every
    // /internal/v1 route requires - leave it empty here and set RUNNER_INTERNAL_TOKEN instead, the
    // same variable the gateway reads, so one value configures both sides. With neither set the
    // gateway closes its internal surface with 503, which the engine reads as "the fabric is not
    // deployed" and degrades on rather than failing a step.
    "GatewayBaseUrl": "http://runner-gateway:8090",
    "InternalToken": "",
    "RunnerQueryCacheSeconds": 5,
    "RequestTimeoutSeconds": 30,
    "JobWaitSeconds": 30,
    "SessionWaitSeconds": 900,
    // D12: verification of output produced by a runner. Applies from the moment a compute target
    // other than Local exists (D6); with Compute:Mode=Local nothing resolves a runner output and
    // these values are inert.
    "OutputVerification": {
      "SpotCheckPercent": 10,
      "SpotCheckWindowSeconds": 1.0,
      "SpotCheckWindows": 3,
      "ProbeTimeoutSeconds": 60,
      "SpotCheckTimeoutSeconds": 60,
      "MaxHashBytes": 536870912,
      "ProbeUrlTtlSeconds": 600,
      "DurationToleranceSeconds": 0.25
    }
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "reelforge",
    "Region": "garage"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "InferenceApi": {
    "BaseUrl": "http://localhost:8080"
  },
  "Sandbox": {
    "BaseUrl": "http://sandbox-executor:8080",
    "GoogleFonts": {
      "Enabled": false,
      "TimeoutSeconds": 30
    }
  },
  "WorkflowEngine": {
    "MaxConcurrency": 4,
    "AgentParallelism": 4,
    "AgentRunTimeoutSeconds": 3000,
    "ContextBudget": {
      "Enabled": true,
      "MaxInputChars": 160000,
      "MaxDigestedStepChars": 12000,
      "RecentStepsVerbatim": 2,
      "DigestMaxStringChars": 600,
      "DigestMaxArrayItems": 25,
      "DigestMaxDepth": 12
    },
    "ToolLoopBudget": {
      "Enabled": true,
      "MaxContextChars": 200000,
      "RecentToolResultsVerbatim": 4,
      "DigestMaxChars": 2000,
      "CompactCallArguments": true
    },
    "ToolLoop": {
      "MaxIterations": 40,
      "MaxConsecutiveErrors": 3
    },
    "StepCache": {
      "Enabled": true,
      "TtlHours": 168,
      "MaxEntryChars": 2000000,
      "ValidateStorageArtifacts": true
    },
    "Guardrails": {
      "ToolScreening": "Off",
      "StateMaxChars": 4000
    }
  },
  "WorkflowHardening": {
    "EnableStructuredRetryDiagnostics": true,
    "MaxStepRetries": 3,
    "MaxAuthorStepRetries": 3,
    "MaxTranslatorStepRetries": 3,
    "RetryBaseDelaySeconds": 2
  },
  "Agents": {
    "RemotionComponentTranslator": { "RunTimeoutSeconds": 10800 },
    "Author": { "RunTimeoutSeconds": 10800 },
    "MotionGraphicsPlanner": { "RunTimeoutSeconds": 7200 },
    "MotionGraphicsDirector": { "RunTimeoutSeconds": 7200 }

    // ---------------------------------------------------------------------
    // Decision gate (System One, model-driven decisions) — per-site thresholds.
    //
    // EVERY key below ships COMMENTED OUT, and the only Mode value written anywhere below is
    // `Off`. Phase 1 shipped zero Decision/DecisionGate keys in this file and that stays true:
    // nothing here may enable the gate.
    //
    // Full key space, per agent, under Agents:<Agent>:DecisionGate:
    //   Mode                                   Off | Shadow | Gate   (Off is the only shipped value)
    //   AcceptAt                               0.85   phase-1 fallback, NOT a tuned/calibrated value
    //   MinMargin                              0.25   phase-1 fallback, NOT a tuned/calibrated value
    //   ProviderId                             a Decision provider GUID; absent => the capability default
    //   Sites:<QuestionName>:AcceptAt          per-question override, that question ONLY
    //   Sites:<QuestionName>:MinMargin         per-question override, that question ONLY
    //
    // <QuestionName> is the question's NAME exactly as the gate poses it: the Colorist's
    // "Look", "Strength", "ShadowTone", "HighlightTone"; the MusicSupervisor's "Intensity",
    // "Ducking", "Fit". A site key is optional, and a missing one simply falls back to the
    // agent-level key above it, then to the 0.85/0.25 defaults.
    //
    // docker-compose.yml already passes the AGENT-LEVEL Agents:Colorist:DecisionGate:Mode and
    // Agents:MusicSupervisor:DecisionGate:Mode as environment passthroughs
    // (COLORIST_DECISION_GATE_MODE / MUSIC_SUPERVISOR_DECISION_GATE_MODE, both defaulting to Off),
    // so the new SITE keys must be reachable the same way: an environment variable named after the
    // key with `:` replaced by `__`, e.g. Agents__Colorist__DecisionGate__Sites__Look__AcceptAt.
    // No compose change is made by this initiative — docker-compose.yml is Platform's surface.
    //
    // "Colorist": {
    //   "DecisionGate": {
    //     "Mode": "Off",
    //     "AcceptAt": 0.85,
    //     "MinMargin": 0.25,
    //     "ProviderId": null,
    //     "Sites": {
    //       "Look": { "AcceptAt": 0.85, "MinMargin": 0.25 }
    //     }
    //   }
    // },
    // "MusicSupervisor": {
    //   "DecisionGate": {
    //     "Mode": "Off",
    //     "AcceptAt": 0.85,
    //     "MinMargin": 0.25,
    //     "Sites": {
    //       "Intensity": { "AcceptAt": 0.85, "MinMargin": 0.25 }
    //     }
    //   }
    // }
    // ---------------------------------------------------------------------
  }
}
