{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=reelforge;Username=postgres;Password=postgres"
  },
  // Pool cap: Database:MaxPoolSize (env Database__MaxPoolSize) > "Maximum Pool Size" in the connection
  // string > 20. Deliberately not set here, so a value in the connection string is not overridden.
  // ServerConnectionSampleSeconds: how often the server connection count (sum(numbackends) in
  // pg_stat_database) is sampled for the alert; 0 disables.
  "Database": {
    "ServerConnectionSampleSeconds": 30
  },
  // The versions of the legal documents this deployment serves (F-7). Seeded into legal_documents
  // on first boot ONLY — a restart never overwrites a published version, and publishing a new one
  // is PUT /api/v1/legal/documents/{document}. The Go API reads that table and pins every recorded
  // acceptance to it, so these keys decide what a fresh install starts with, not what it serves.
  "Legal": {
    "TermsVersion": "2026-11-17",
    "PrivacyVersion": "2026-11-17"
  },
  "Jwt": {
    "Issuer": "reelbolt-api",
    "Audience": "reelbolt-inference",
    "SigningKey": ""
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "reelforge",
    "Region": "garage"
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "DeploymentName": "gpt-4o-mini",
    "ApiKey": ""
  },
  "DataProtection": {
    "KeysPath": "/keys"
  },
  "Inference": {
    "ProviderCacheSeconds": 60
  },
  // Short-lived output links (GET /api/v1/output-links/{token}, minted by the assistant's GetOutput).
  // DefaultTtlMinutes is clamped to 60. PublicBaseUrl empty: falls back to CloudStorage:PublicBaseUrl
  // (compose PUBLIC_BASE_URL), else links are relative to this API.
  "OutputLinks": {
    "DefaultTtlMinutes": 15,
    "PublicBaseUrl": ""
  },
  // Guest review links (docs/design/guest-review-links.md). DefaultExpiryDays/MaxExpiryDays bound the owner's expiry
  // choice; MaxLinksPerTimeline counts live links; MaxGuestCommentsPerLink is a database count;
  // GuestCommentsPerMinute is an in-memory window PER API REPLICA (the nginx write zone is the shared limit).
  // Keep Logging:LogLevel:Microsoft.AspNetCore at Warning or higher: lower levels log route values, which here are tokens.
  "ReviewLinks": {
    "DefaultExpiryDays": 14,
    "MaxExpiryDays": 90,
    "MaxLinksPerTimeline": 20,
    "MaxGuestCommentsPerLink": 200,
    "GuestCommentsPerMinute": 10
  },
  // The platform assistant's per-turn reasoning effort (AssistantChatLimits.ReasoningEffortKey).
  // The code's own default is "none" — thinking off — because an interactive chat reply should not
  // spend its first second deliberating; this deployment asks for "medium", since the assistant
  // composes workflows and edits pictures through tools, where the deliberation earns its latency.
  // "auto" would send no reasoning field at all, leaving the provider's own default in place.
  "Assistant": {
    "ReasoningEffort": "medium"
  },
  // Analysis at upload: a project opts in (projects.analyze_on_upload); false here means no upload ever asks
  // the engine to analyse a new video, whatever a project chose.
  "MediaAnalysis": {
    "OnUpload": {
      "Enabled": true
    }
  },
  // Import from a public https URL (POST files/import-url, ApplyImportFileFromUrl): at most MaxBytes
  // (512 MiB) per file and TimeoutSeconds for the whole download; the plan's storage quota still applies.
  // At most MaxConcurrentPerOrg imports per organization and MaxConcurrent in all run at once per process
  // (more answer IMPORT_BUSY). Bodies spool to SpoolDirectory (empty = system temp), which must keep
  // SpoolMinFreeBytes free beyond what running imports may still write. A silent upstream is stopped after
  // StallTimeoutSeconds; after ThroughputGraceSeconds the average must stay at MinBytesPerSecond (IMPORT_TIMEOUT).
  "FileImport": {
    "MaxBytes": 536870912,
    "TimeoutSeconds": 300,
    "StallTimeoutSeconds": 30,
    "MinBytesPerSecond": 32768,
    "ThroughputGraceSeconds": 30,
    "MaxConcurrentPerOrg": 2,
    "MaxConcurrent": 4,
    "SpoolDirectory": "",
    "SpoolMinFreeBytes": 1073741824
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  // The durable repair for lost derivative requests (MediaDerivativeCoverageService). An upload
  // publishes its derivative request best-effort, so a broker block used to leave the video playing
  // its original forever. This sweep re-derives "video source with no proxy" from the source rows and
  // requests the set again, so a lost publish costs one interval. BatchSize bounds one sweep (oldest
  // source first); Enabled false or IntervalMinutes 0 disables the timer while keeping the platform
  // admin coverage/backfill endpoints working.
  "MediaDerivatives": {
    "Backfill": {
      "Enabled": true,
      "IntervalMinutes": 10,
      "BatchSize": 200,
      "StartupDelaySeconds": 60
    }
  },
  // GitHub App integration (docs/github-app.md). Nothing here is a secret: the app id, the
  // private key, the webhook secret and the OAuth client secret are SECRETS and come from the
  // environment only (GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY / GITHUB_WEBHOOK_SECRET /
  // GITHUB_APP_CLIENT_SECRET, or the __-separated GitHub__* keys). With the app id, the key and
  // the webhook secret absent the webhook answers 503 and linking is refused; with the client id,
  // client secret or callback URL absent, connecting a person's GitHub account — and therefore the
  // repository picker — is refused 503 github_oauth_not_configured, and by-name linking still works.
  "GitHub": {
    "AppId": "",
    "AppSlug": "",
    "PrivateKeyPem": "",
    "PrivateKeyPath": "",
    "WebhookSecret": "",
    "ClientId": "",
    "ClientSecret": "",
    "OAuthCallbackUrl": "",
    "OAuthAuthorizeUrl": "https://github.com/login/oauth/authorize",
    "OAuthTokenUrl": "https://github.com/login/oauth/access_token",
    "OAuthStateTtlSeconds": 600,
    "MaxRepositoriesListed": 500,
    "ApiBaseUrl": "https://api.github.com",
    "MaxFilesPerPull": 2000,
    "MaxFileBytes": 52428800,
    "MaxTotalBytes": 536870912,
    "WorkerIntervalSeconds": 15,
    "MaxDeliveryAttempts": 5
  },
  "VectorSearch": {
    "QdrantUrl": "http://localhost:6333",
    "QdrantGrpcPort": 6334,
    "EmbeddingDeployment": "text-embedding-3-large",
    "ChunkSizeTokens": 512,
    "ChunkOverlapTokens": 64,
    "SmallFileThresholdTokens": 1500
  },
  "WorkflowTemplates": {
    "EnableAutoStarter": true,
    "EnableAdvancedTemplates": true
  },
  // the profile build's LLM-fallback cap is DYNAMIC, enforced on every route that starts the
  // product-profile-from-code template: the cold-start HIGH of the reference template priced at the live
  // prices of the resolved models, times DesignSystem:Build:FallbackCapMargin (default 1.3, set it only to
  // change it). DesignSystem:Build:MaxFallbackCreditsHigh is an optional absolute ceiling in credits: unset
  // here on purpose, and applied (cap = min(dynamic, ceiling)) only when a deployment sets it.
  // SPEC 16.4 figma-variables: the one-shot import stays off by default. Turning it on exposes a
  // route that accepts a caller's Figma Personal Access Token for the lifetime of one request (it is
  // never stored, logged or echoed).
  // Import:Pdf:Enabled is the brand-PDF kill switch (SEC-7): true (the default, SIGNOFF D.3 keeps pdf-text
  // on) serves POST .../import/pdf; false makes it answer 404 feature_disabled without reaching the worker.
  "Import": {
    "Figma": {
      "Enabled": false
    },
    "Pdf": {
      "Enabled": true
    }
  },
  "Account": {
    "InternalBaseUrl": "http://go-api:8080",
    "InternalToken": "",
    "Export": {
      "Enabled": true,
      "ThrottleHours": 24,
      "LinkTtlDays": 7,
      "MaxPackedBytes": 2147483648,
      "Prefix": "exports",
      "SweepIntervalMinutes": 60,
      "SweepMaxObjects": 5000
    },
    "Purge": {
      "Enabled": true,
      "GraceDays": 30,
      "IntervalMinutes": 60,
      "PurgeUnverified": false,
      "UnverifiedDays": 7,
      "MaxPerSweep": 25,
      "DeleteBatchSize": 1000
    }
  },
  // MCP OAuth table hygiene (docs/design/mcp-oauth.md §5). The OAuth server and the MCP bridge write
  // these rows; the values below are the sweep's safe defaults, listed here so the knob is visible.
  // RevokedTokenGraceHours deliberately outlives rotation: a just-rotated token that is replayed must
  // still be found, because finding it is what revokes the grant. Raise it to 720 to keep that
  // detection for the token's whole 30-day life.
  "McpOAuth": {
    "Purge": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "InitialDelaySeconds": 60,
      "UnclaimedClientRetentionDays": 7,
      "RevokedTokenGraceHours": 24,
      "BatchSize": 500,
      "MaxRowsPerTablePerRun": 5000
    }
  },
  // Billing/model-catalog.seed.json -> model_capability_prices at boot (platform capabilities only; admin-owned
  // rows are never touched). Apply (default) | DryRun (log what would change, write nothing) | Off.
  "ModelCatalog": {
    "SeedPrices": "Apply"
  },
  // CSAM hash matching (Project Arachnid Shield, docs/csam.md). Disabled until an account is
  // configured; off means no provider request, a "disabled" audit row and rows stay NotScanned. Credentials come from
  // ARACHNID_API_USERNAME / ARACHNID_API_PASSWORD (Csam__Arachnid__Username / __Password) and are
  // sent as HTTP Basic auth only — never in a URL or query string. With both set, the only outbound
  // host is Arachnid:BaseUrl — never a general moderation API. Fail open: a timeout, 5xx, malformed
  // body, transport error or missing credential marks the row NotScanned and the upload proceeds.
  // MaxInlineHashBytes bounds the local-PDQ path; larger images use /v1/media.
  "Csam": {
    "Arachnid": {
      "Enabled": false,
      "BaseUrl": "https://shield.projectarachnid.com",
      "Username": "",
      "Password": "",
      "AuthHeader": "Authorization",
      "TimeoutSeconds": 10,
      "MaxInlineHashBytes": 67108864
    },
    // Sweeps Pending rows written by cloud/GitHub sync, the assistant and the engine.
    // IntervalMinutes = 0 disables it; RescanNotScanned retries NotScanned rows after 24h.
    "Sweeper": {
      "IntervalMinutes": 15,
      "BatchSize": 25,
      "RescanNotScanned": false
    }
  },
  // Project versioning (initiative project-versioning). Automatic versions expire after
  // AutoRetentionDays; named versions are kept until deleted. A capture HEADs unhashed files at most
  // MaxHeadsPerCapture times (HeadConcurrency at once); past that the item is stored unverified.
  // AutoCapture=false turns off every best-effort automatic capture path.
  "ProjectHistory": {
    "MaxFilesPerVersion": 20000,
    "AutoRetentionDays": 30,
    "MaxHeadsPerCapture": 2000,
    "HeadConcurrency": 8,
    "MaxNonNamedVersions": 200,
    "MaxNamedVersions": 100,
    "AutoCapture": true,
    "AutoCaptureTimeoutSeconds": 10,
    "IdleSweepIntervalSeconds": 600,
    "IdleSweepBatchSize": 200,
    "IdleMinutes": 10,
    "IdleLookbackHours": 24,
    "HashSweepEnabled": true,
    "HashSweepIntervalSeconds": 60,
    "HashSweepBatchSize": 50,
    "GcBatchSize": 500
  },
  // Tracked links of the new-user funnel (docs/design/new-user-funnel.md): GET /api/v1/l/{code}, which the
  // public host maps /l/{code} to, counts the click per link and UTC day (no cookie, nothing about the
  // caller) and redirects to the link's landing page with its UTM parameters. Enabled=false makes the
  // redirect answer a bare 404 for every code; the platform-admin links routes keep working.
  "Marketing": {
    "Links": {
      "Enabled": true
    }
  },
  // UrlCaptureEnabled mirrors the Go API's ATTRIBUTION_URL_CAPTURE_ENABLED (compose passes the same
  // variable to both). The Go API is what records campaign parameters carried in a signup request with no
  // cookie (user_attribution.capture = 'url'); here the value is only reported by the links funnel
  // (urlCaptureEnabled), so the admin page can say whether account counts per link are complete.
  "Attribution": {
    "UrlCaptureEnabled": false
  }
}

