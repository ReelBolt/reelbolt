# Dependencies
node_modules/
# package-lock.json is deliberately NOT ignored here. Dockerfile runs `npm ci`, which REQUIRES a
# committed lockfile; ignoring it would let a fresh clone (or a `git rm --cached`) break the image
# build. yarn.lock / pnpm-lock.yaml stay ignored because this package uses npm.
yarn.lock
pnpm-lock.yaml

# Build output
dist/
build/
.turbo/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.vim

# Testing
coverage/
.nyc_output/

# Yarn berry
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
