# Pinned sources for the runner's bundled static ffmpeg (WP E10b).
#
# ffmpeg is shipped as a SEPARATE PROCESS, never linked: ReelBolt invokes
# ffmpeg/ffprobe as a subprocess over the user's own media. Aggregation, not
# linking, is what the GPL permits here, which is why this build is a GPL one
# (libx264 and libmp3lame are required for output parity with the cloud render
# - see docs/design/desktop-runner-adr.md, decision 4).
#
# Every download is verified against a SHA-256 before it is unpacked. The three
# digests ship as CHANGE_ME because pinning a hash is an act of trust that has
# to be performed against the real upstream artifact, not copied out of a
# document: build.sh refuses to run until they are filled in, and prints the
# digest of what it downloaded so filling them in is one command.
#
# To pin (once, on a trusted machine with network access):
#
#   runner/build/ffmpeg/build.sh --target linux/amd64 --pin
#
# That downloads each source, prints its SHA-256 and exits without building.
# Paste the three digests below, review the diff, and commit it. From then on
# every CI run re-downloads and verifies, so a changed upstream tarball fails
# the build instead of being built into a released binary.

# ffmpeg. Upstream publishes a detached GPG signature (.asc) per tarball but no
# checksum file; set FFMPEG_GPG_KEYRING to a keyring holding ffmpeg's release
# key and build.sh will verify the signature as well.
FFMPEG_VERSION=7.1
FFMPEG_SHA256=40973d44970dbc83ef302b0609f2e74982be2d85916dd2ee7472d30678a7abe6

# x264. There are no releases: upstream is a git repository and the snapshot is
# pinned by commit. This is the master HEAD of 2025-05-12.
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
X264_SHA256=6eeb82934e69fd51e043bd8c5b0d152839638d1ce7aa4eea65a3fedcf83ff224

# LAME (libmp3lame).
LAME_VERSION=3.100
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# Configure flags shared by every target. Read them as the licence boundary:
# --enable-gpl is what makes libx264 legal to bundle, and --disable-network is
# what stops a media tool from being pointed at a URL (the runner only ever
# hands it staged local files).
FFMPEG_CONFIGURE_FLAGS="\
--disable-shared --enable-static --enable-gpl \
--disable-network --disable-doc --disable-debug --disable-autodetect \
--enable-libx264 --enable-libmp3lame \
--enable-pic --enable-small"

# The ffmpeg digest was cross-checked against the upstream detached GPG signature
# (ffmpeg-7.1.tar.xz.asc): Good signature from the FFmpeg release signing key
# ffmpeg-devel@ffmpeg.org, fingerprint FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8.
# x264 and lame are pinned by commit and tag over TLS.
