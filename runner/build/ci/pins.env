# Pins for the Linux release build container (runner/build/ci/linux-inside.sh)
# and the publish step. Plain KEY=value, sourced by sh. Every download is
# verified against the sha256 here; bumping a version means bumping its digest in
# the same commit.

# ubuntu:24.04, the oldest glibc the Linux artifacts support. Pinned by digest.
BUILD_IMAGE=ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

# Go: runner/go.mod says 1.26.0, Ubuntu 24.04 ships older, so the container
# installs this exact toolchain.
GO_VERSION=1.26.10
GO_SHA256_AMD64=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5
GO_SHA256_ARM64=3f4227ce7b206a513e794f1393adb473a07b46e94d18bd15d1c684bbb7319797

# Node, for the window's vite bundle.
NODE_VERSION=22.23.4
NODE_SHA256_AMD64=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
NODE_SHA256_ARM64=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b

# nfpm is not a dependency of the runner module; go install verifies it against
# the Go module checksum database.
NFPM_VERSION=v2.43.0

# appimagetool: a versioned release (1.9.1), not the moving "continuous" channel.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_SHA256_AMD64=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGETOOL_SHA256_ARM64=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158

# publish.sh uses the host's aws if present, else this image (pinned by digest).
AWSCLI_IMAGE=amazon/aws-cli:2.17.40@sha256:db8d39443ef512d4724becfac59ec9b7c4f8621e7b3c6200be56cd4fc2dc9570

# Keyless signing of the installers (optional). Linux amd64 binary.
COSIGN_VERSION=v3.1.4
COSIGN_SHA256_AMD64=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
