# ── Production checklist ─────────────────────────────────
# This file is tuned for a local trial. Before the install is reachable by anyone else:
#   - APP_ENV=production, ASPNETCORE_ENVIRONMENT=Production
#   - WEB_BUILD_TARGET=production, WEB_NODE_ENV=production, WEB_NODE_OPTIONS= (empty),
#     SITE_BUILD_TARGET=production, SITE_NODE_ENV=production
#   - strong values for POSTGRES_PASSWORD, RABBITMQ_PASSWORD, MINIO_ACCESS_KEY, MINIO_SECRET_KEY
#     and a fresh JWT_SIGNING_KEY (postgres, guest and minioadmin are safe on loopback only)
#   - DOMAIN + ACME_EMAIL, then FORCE_HTTPS=true and COOKIE_SECURE=true once https works
#   - SMTP_* set (production never logs email links), SIGNUP_ENABLED=false, SANDBOX_NETWORK_EGRESS=false
# Details: docs/user-guide/self-hosting.md ("Harden the install").
# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reelforge
POSTGRES_PORT=5432

# Least-privilege database logins for a separate media (render) host. Single-host installs leave all
# of this unset: every service then keeps the POSTGRES_USER login above and nothing changes.
#
# CONTROL host .env (the host that runs Postgres). Once the first two are set, every release runs
# an operator script (not in the public repository), which creates the roles and sets these passwords (only a salted
# hash is sent to the server). Printable ASCII, no spaces, all different: openssl rand -hex 32.
# ENGINE_DB_PASSWORD=            # role reelbolt_engine: the engine's runtime login on the media host
# GATEWAY_DB_PASSWORD=           # role reelbolt_gateway: the runner gateway's login on the media host
# ENGINE_MIGRATOR_DB_PASSWORD=   # optional: the engine's migration login. Control host ONLY. While
#                                # unset, the engine-migrator one-shot runs as POSTGRES_USER.
#
# MEDIA host .env holds exactly two database logins and nothing stronger:
# DATABASE_CONNECTION_STRING=Host=<control private IP>;Port=5432;Database=reelforge;Username=reelbolt_engine;Password=<ENGINE_DB_PASSWORD>
# DATABASE_URL=postgres://reelbolt_gateway:<GATEWAY_DB_PASSWORD>@<control private IP>:5432/reelforge?sslmode=disable
# It must NOT contain POSTGRES_PASSWORD, a login as postgres / POSTGRES_USER, the migration login,
# or a Hetzner token (HCLOUD_TOKEN, HCLOUD_TOKEN_FILE, POOL_WAKER_TOKEN_FILE): a media release is
# refused otherwise. During a staged cut-over only, this turns
# the refusal into a loud warning; remove it as the last step:
# MEDIA_ENV_ALLOW_LEGACY=true
# ── Database connection pools ─────────────────────────────
# Per-process ceilings against Postgres max_connections; see docs/database-connections.md.
INFERENCE_DB_MAX_POOL_SIZE=16
ENGINE_DB_MAX_POOL_SIZE=12
GO_API_DB_MAX_OPEN_CONNS=8
GO_API_DB_MAX_IDLE_CONNS=4
GO_API_DB_CONN_MAX_LIFETIME=30m
RUNNER_GATEWAY_DB_MAX_CONNS=4
DB_CONNECTION_SAMPLE_SECONDS=30
# ── Object storage (S3-compatible; backed by Garage, not MinIO — see docker-compose.yml) ─
# Var names kept as MINIO_* since they're just config keys, not a MinIO dependency.
MINIO_ACCESS_KEY=minioadmin
# Garage rejects a secret key under 16 characters at startup (MinIO didn't care) —
# generate a real one with: openssl rand -hex 20
MINIO_SECRET_KEY=CHANGE_ME_16_CHARS_MINIMUM
MINIO_BUCKET=reelforge
MINIO_API_PORT=9000
# Host presigned URLs name, as reachable by a desktop/cloud runner (e.g. https://s3.example.com).
# Empty = use the in-cluster endpoint (fine for Local compute mode only).
MINIO_PUBLIC_ENDPOINT=
# Cloudflare R2 (cloud VMs; docs/cloud-storage.md). Set on the control and engine hosts:
#   MINIO_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com   (EU jurisdiction host)
#   MINIO_PUBLIC_ENDPOINT=<the same URL>
#   MINIO_REGION=auto
#   MINIO_FORCE_PATH_STYLE=true
#   MINIO_BUCKET=<the bucket name set in the object-store configuration>; MINIO_ACCESS_KEY/MINIO_SECRET_KEY = a bucket-scoped R2 token (docs/cloud-storage.md)

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── JWT ──────────────────────────────────────────────────
# REQUIRED. Random value of at least 32 characters — the app refuses to start
# otherwise. Generate one with: openssl rand -hex 32
JWT_SIGNING_KEY=
JWT_ISSUER=reelbolt-api
JWT_AUDIENCE=reelbolt-inference
# Optional on a single host; REQUIRED on a two-box deployment (docker-compose.control.yml and
# docker-compose.media.yml). A second key, `openssl rand -hex 32`, never the JWT_SIGNING_KEY value
# (the services refuse to start if the two are equal). When set, the workflow engine signs its
# calls to the Inference API with this key and accepts only tokens the Inference API mints with it,
# so the engine does not need JWT_SIGNING_KEY: on a render host put ONLY this key in .env and
# leave JWT_SIGNING_KEY out, and set REELBOLT_RENDER_HOST=true (below). Blank = the engine shares
# JWT_SIGNING_KEY as before.
ENGINE_JWT_SIGNING_KEY=
# Render (media / engine) hosts only. Without it, `docker compose` refuses to render when
# JWT_SIGNING_KEY is unset; a render host sets it to true so it can run with the engine key alone.
# A single host or the control host never sets it (the operator environment check refuses it on control).
# REELBOLT_RENDER_HOST=true
# Cut-over only (control host / Inference API). true = still accept the engine's old tokens signed
# with JWT_SIGNING_KEY, on the two routes the engine calls, with a warning per use. Set it for the
# deploy that introduces ENGINE_JWT_SIGNING_KEY, then remove it once the engine host is updated.
ENGINE_JWT_ACCEPT_LEGACY_OBO=false

# ── Azure OpenAI ─────────────────────────────────────────
# These are now the *fallback* chat-completion config, used only when no
# `inference_providers` row exists or no row is marked as the default —
# configure providers at runtime via /admin/inference-providers instead.
# Embeddings (VectorSearch__EmbeddingDeployment above) always use these keys.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── Anthropic / Claude (optional) ───────────────────────
# Claude is configured as an `inference_providers` row of kind `Anthropic` at
# /admin/inference-providers, not from here — these variables exist only so a
# provider row can store the literal `env:` as its api key, in which case the
# Anthropic SDK resolves credentials itself and no secret is persisted in the
# database. Handy for local development; see docs/anthropic-provider.md.
# A BLANK api key is rejected outright, deliberately: it would otherwise make a
# misconfigured or undecryptable row silently bill these credentials instead.
#
# CREDENTIAL BOUNDARY — read before filling either of these in:
#   A Claude Pro/Max subscription token (ANTHROPIC_AUTH_TOKEN, as minted by
#   `claude setup-token`) is licensed for ORDINARY, INDIVIDUAL use by the person
#   who owns it. That covers running ReelBolt locally against your own account.
#   It does NOT cover a deployed ReelBolt executing workflows for other people —
#   routing other users' requests through subscription credentials is explicitly
#   not permitted. Use a Console API key (ANTHROPIC_API_KEY) or Bedrock/Vertex/
#   Foundry for anything user-facing.
#   https://code.claude.com/docs/en/legal-and-compliance
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# ── Project Arachnid Shield (optional; CSAM hash matching) ──
# The master switch, bound to Csam:Arachnid:Enabled. Self-host default is false; the cloud control
# overlay sets it true. When false, the matcher calls nothing and writes a "disabled" audit row.
# When true but the credentials are blank, the control is "not configured": uploads and runs
# proceed, and the scan is audited as not-scanned (fail open, docs/csam.md). A startup ERROR names
# the mismatch if credentials are present while the switch is false. Never commit real values.
CSAM_ENABLED=false
ARACHNID_API_USERNAME=
ARACHNID_API_PASSWORD=

# ── Google Gemini (optional) ─────────────────────────
# Gemini is configured as an `inference_providers` row of kind `Gemini` at
# /admin/inference-providers, not from here — these variables exist only so a
# provider row can store the literal `env:` as its api key, in which case ReelBolt
# resolves credentials from the environment and no secret is persisted in the
# database. Handy for local development; see docs/gemini-provider.md.
# A BLANK api key is rejected outright, deliberately: it would otherwise make a
# misconfigured or undecryptable row silently bill ambient credentials instead.
#
# HOW TO GET AN API KEY:
#   1. Visit Google AI Studio: https://aistudio.google.com/app/apikey
#   2. Sign in with your Google account.
#   3. Click "Create API key".
#   4. Use the key directly in the provider form or set GEMINI_API_KEY below and
#      use `env:` as the provider's API key.
#
# NOTE ON GOOGLE SUBSCRIPTIONS:
#   Consumer subscriptions (Gemini Advanced / Google One AI Premium) apply to the
#   Gemini web app (gemini.google.com) and Workspace apps; they do NOT include
#   direct developer API keys or API credits.
#   However, Google AI Studio offers a generous FREE TIER (e.g. 15 RPM / 1M TPM
#   for Flash models) without needing a credit card — perfect for running tests!
#   For higher limits or production, link a Google Cloud project with billing enabled.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── DeepSeek (optional) ──────────────────────────────
# DeepSeek is configured as an `inference_providers` row of kind `DeepSeek` at
# /admin/inference-providers, not from here — these variables exist only so a
# provider row can store the literal `env:` as its api key, in which case ReelBolt
# resolves credentials from the environment and no secret is persisted in the
# database. Handy for local development; see docs/deepseek-provider.md.
# A BLANK api key is rejected outright, deliberately: it would otherwise make a
# misconfigured or undecryptable row silently bill ambient credentials instead.
#
# HOW TO GET AN API KEY:
#   1. Visit DeepSeek Platform: https://platform.deepseek.com/
#   2. Sign in or create an account.
#   3. Generate an API key under API Keys.
#   4. Use the key directly in the provider form or set DEEPSEEK_API_KEY below and
#      use `env:` as the provider's API key.
DEEPSEEK_API_KEY=

# ── SMTP (optional — logs OTP to console if not set) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The single From address, used by BOTH providers (Cloudflare and SMTP).
SMTP_FROM=
# Optional Reply-To on every transactional mail (verification, welcome, reset, invitation, ...):
# where a person's reply goes. One bare address, e.g. support@reelbolt.ai. Empty sends no
# Reply-To, so a reply goes to SMTP_FROM, which is often a mailbox nobody reads.
MAIL_REPLY_TO=
# Cloudflare Email Sending (optional): the outbound provider when both of these are set, in which
# case it takes precedence over SMTP. CLOUDFLARE_EMAIL_TOKEN is a Cloudflare USER API token — a
# SECRET, and NOT an R2 key — and CLOUDFLARE_EMAIL_ACCOUNT_ID is the account the sending domain is
# onboarded on (the same account as MINIO_ENDPOINT's hostname). With either blank, mail falls back
# to SMTP, then to console logging; go-api logs which provider it selected at startup. The sending
# domain must be onboarded on the account (SPF/DKIM) or every send fails with a 4xx.
CLOUDFLARE_EMAIL_TOKEN=
CLOUDFLARE_EMAIL_ACCOUNT_ID=
# Key for the recipient reference mail logs print instead of an address (rcpt=<12 hex of
# HMAC-SHA256(key, mailbox)>), read by go-api and inference alike. A SECRET: generate it with
# `openssl rand -hex 32` and never reuse JWT_SIGNING_KEY. Blank = each service picks a random key
# per process (refs then stop matching across services and restarts) and warns at startup.
MAIL_LOG_REF_KEY=
# Daily operator digest by mail: platform step failures (refunded to the platform), runs by final
# status and new feedback reports of the last 24 hours, one mail at 06:00 UTC. OFF by default. Set the
# address AND OPERATOR_DIGEST_ENABLED=true; go-api relays the mail to this address only (it reads
# the same variable), and the Inference API refuses to start when enabled without it. Needs
# INTERNAL_API_TOKEN and working outbound mail. Error text is redacted and cut to 160 characters.
OPERATOR_DIGEST_ENABLED=false
OPERATOR_DIGEST_EMAIL=
# Display name on outgoing mail, and the public origin used for links in emails
MAIL_FROM_NAME=ReelBolt
PUBLIC_BASE_URL=http://localhost
# The origin the Go API's own mail links are built from (F-11). Defaults to PUBLIC_BASE_URL;
# set it when the dashboard is not the marketing site, so the link the mailer validates
# against and the link the mail names name the same origin.
LINK_BASE_URL=
# Extra origins, besides LINK_BASE_URL, whose host a templated mail's link may name (F-11,
# comma-separated http(s) origins, e.g. the presigned storage endpoint). Unset allows only the
# configured base URL's origin — an empty list must not degrade to "any host".
MAIL_LINK_HOSTS=
# Self-serve signup (POST /api/v1/auth/signup). false keeps the install invite-only.
SIGNUP_ENABLED=false
# Web: the app view of workflows (project app gallery, app run page). Read by the web server per
# request; unset or true = on, false = today's Workflows tab and workflow page exactly.
WORKFLOW_APPS_ENABLED=true
# Signup abuse controls (docs/design/saas-accounts.md "Implemented abuse controls")
# Reject signups from disposable-email domains (embedded snapshot of disposable-email-domains)
ABUSE_BLOCK_DISPOSABLE=true
# Also require the email domain to have a mail server (one DNS lookup per signup)
ABUSE_MX_CHECK=false
# Cloudflare Turnstile secret; empty skips the challenge. The client sends it as turnstileToken.
TURNSTILE_SECRET=
# The matching *site* key (public, not a secret). The web app renders the challenge when it is set,
# and the signup form sends the token as turnstileToken. Leave empty to skip the challenge.
TURNSTILE_SITE_KEY=
# Would send the trial grant through a $0 card checkout. NO EFFECT until the Paddle integration (B9b).
TRIAL_REQUIRES_CARD=false

# ── OAuth sign-in (optional — both endpoints 404 without credentials) ────
# C10. A provider is offered only when BOTH its id and secret are set; the endpoints and scopes are
# fixed in api/handlers/auth/oauth.go, so no env var can point them at another host. Only an address
# the provider reports as verified can sign in. The sign-in pages ask the API which providers are
# configured, so the buttons appear as soon as both values are set. With SIGNUP_ENABLED=false a
# provider sign-in only reaches EXISTING verified accounts; it never creates one (invite-only stays
# invite-only).
# Google: https://console.cloud.google.com/apis/credentials — authorized redirect URI
#   {PUBLIC_BASE_URL}/api/v1/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers — callback URL
#   {PUBLIC_BASE_URL}/api/v1/auth/oauth/github/callback
#
# NOTE: this is a GitHub *OAuth App*, used to SIGN IN. It is a different GitHub object from the
# GitHub *App* below, which reads repositories. A GitHub App's client id (Iv1.…) does not work here.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── GitHub App (docs/github-app.md, docs/github-app-setup.md) ────
# Created and installed by the owner in their own GitHub account; ReelBolt never creates one and
# never asks for a personal access token. All five are set on the **inference** service.
# GITHUB_APP_ID is the numeric App ID; GITHUB_APP_PRIVATE_KEY is the whole generated PEM (a literal
# \n is accepted as a newline). GITHUB_APP_WEBHOOK_SECRET is the only credential the webhook trusts.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Or a path inside the inference container to a bind-mounted PEM (used when the above is empty).
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
# Connecting a person's GitHub account so the dashboard can LIST their repositories instead of asking
# them to type one (docs/github-app.md, "Connecting a GitHub account"). These are a SECOND credential
# set, not the same one: GITHUB_APP_CLIENT_ID is the Iv1.… value on the App's settings page, NOT the
# App ID, and GITHUB_APP_CLIENT_SECRET is generated under "Client secrets" there.
# GITHUB_APP_OAUTH_CALLBACK_URL must equal one of the App's registered "Callback URL" values exactly:
#   {PUBLIC_BASE_URL}/api/v1/github/oauth/callback
# With any of the three missing, connecting an account answers 503 github_oauth_not_configured and
# the repository picker is unavailable; linking by owner/name keeps working.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_OAUTH_CALLBACK_URL=

# ── Cloud storage sync (docs/cloud-drive-sync.md) ────
# Lets a project mirror one folder from Google Drive, OneDrive/SharePoint or Dropbox (read-only: ReelBolt
# never writes to, moves or deletes anything there). Set on the **inference** service. Each provider is
# off — hidden in the dashboard, its endpoints answering 503 provider_not_configured — until BOTH its
# client id and its secret are set, so leave a pair empty to not offer that provider. Connecting also
# needs PUBLIC_BASE_URL (above): the redirect URI to register with each vendor, byte for byte, is
#   {PUBLIC_BASE_URL}/api/v1/cloud-storage/google-drive/oauth/callback
#   {PUBLIC_BASE_URL}/api/v1/cloud-storage/onedrive/oauth/callback
#   {PUBLIC_BASE_URL}/api/v1/cloud-storage/dropbox/oauth/callback
#
# Google Drive: Google Cloud console → APIs & Services → enable the "Google Drive API", configure the
# OAuth consent screen, then Credentials → Create OAuth client ID → "Web application", with the redirect
# URI above. Scope used: drive.readonly — a restricted scope, so a public deployment needs Google's OAuth
# verification; an unverified ("testing") app works for up to 100 listed test users.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# OneDrive / SharePoint (Microsoft Graph): Microsoft Entra admin center → App registrations → New
# registration ("Accounts in any organizational directory and personal Microsoft accounts"), platform
# "Web" with the redirect URI above; Certificates & secrets → New client secret (copy the VALUE, not
# its id). Delegated permissions: offline_access, User.Read, Files.Read.All, Sites.Read.All.
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
# "common" (work, school and personal accounts), "organizations", "consumers", or one tenant id.
MICROSOFT_GRAPH_TENANT=common
# Dropbox: App Console (https://www.dropbox.com/developers/apps) → Create app → "Scoped access",
# "Full Dropbox"; Permissions: account_info.read, files.metadata.read, files.content.read; add the
# redirect URI above under OAuth 2. The app key is the client id, the app secret the client secret.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# How often, in minutes, every linked folder is re-synced in the background. 0 turns the periodic sync
# off ("Sync now" only).
CLOUD_SYNC_SWEEP_MINUTES=30

# ── Data export and account deletion (C9, docs/user-guide/your-data.md) ────
# Shared secret between the Go API (which owns SMTP and the templates) and the Inference API, which
# asks it to send the mails it triggers. Empty leaves POST /internal/mail/send unexposed (404) and
# every such mail skipped with a log line; generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=
# The origin the export archive's presigned GET is minted against, declared so the Go mailer (F-11)
# can tell whether it will accept the link (it is this side's MinIO__PublicEndpoint / MinIO__Endpoint).
# When the minted link names a different origin, the mail goes out without the link (a log line
# says so) instead of being refused; the archive stays available through the export endpoint.
ACCOUNT_MAIL_LINK_ENDPOINT=
# The export archive ("download my data"). false answers 404 on both export endpoints.
ACCOUNT_EXPORT_ENABLED=true
# The 30-day purge that runs after a deletion request. false keeps every account forever.
ACCOUNT_PURGE_ENABLED=true
# Days between the deletion request and the purge; signing in during this window cancels it.
ACCOUNT_PURGE_GRACE_DAYS=30
# Purge accounts that never verified their email. Cloud only (TENANCY_MODE=Cloud) in the code path.
ACCOUNT_PURGE_UNVERIFIED=false
# development logs email action links when SMTP is unset; production never does
APP_ENV=development

# ── Initial Admin User ──────────────────────────────────
ADMIN_EMAIL=admin@reelbolt.local
# Leave empty to auto-generate a random password, printed once to the go-api
# container logs on first boot. A password change is always forced on first login.
ADMIN_PASSWORD=

# ── Workflow Engine ──────────────────────────────────────
WORKFLOW_MAX_CONCURRENCY=4
# Plan priority for Pro/Team/Enterprise runs (B8c, docs/billing.md "Plan priority"). Leave at 10
# unless the broker already holds an argument-less "workflow-execution" queue - declaring a queue
# with a new x-max-priority argument fails with PRECONDITION_FAILED, so 0 is the escape hatch.
WORKFLOW_QUEUE_MAX_PRIORITY=10
# Compute fabric (WP D6, docs/compute-fabric.md). Local is the shipped value and the whole
# self-host story: the engine runs every step in-process and never calls the gateway. Set
# COMPUTE_MODE=Fabric (with RUNNER_INTERNAL_TOKEN below) only if you are running the gateway;
# start it with: docker compose --profile fabric up -d runner-gateway.
# The fabric's callers are not in the tree yet, so Fabric routes no step to a runner today.
COMPUTE_MODE=Local
# Shared secret for the gateway's cluster-internal /internal/v1 API. ONE value configures both
# sides: the engine sends it as a bearer token and the gateway requires it. With none set the
# gateway answers 503 internal_api_disabled and the engine reads that as "the fabric is not
# deployed" and keeps the step local - never a failed workflow. Generate with: openssl rand -hex 32
RUNNER_INTERNAL_TOKEN=
# Two-box deployments only (operator document, not in the public repository): directory holding
# the certificates made by an operator script (not in the public repository). On the media host it holds
# server.pem, server-key.pem, ca-client.pem; on the control host ca.pem, client.pem, client-key.pem.
# Defaults to ./certs/gateway-internal/{server,client}. Never commit these files (git-ignored).
# GATEWAY_INTERNAL_TLS_DIR=
# Control host, only with the on-demand pool: the pool waker's own client certificate directory
# (waker/ from the same script: ca.pem, client.pem, client-key.pem; the key owned by uid 10001).
# Defaults to ./certs/gateway-internal/waker.
# POOL_WAKER_GATEWAY_TLS_DIR=
# Media host, once the certificates are in place: serve the internal API over TLS on this port and
# (after the link is verified) restrict the plain port to the host's own compose network.
# RUNNER_GATEWAY_INTERNAL_TLS_ADDR=:8443
# RUNNER_GATEWAY_INTERNAL_PLAIN_LOCAL_ONLY=true
# HS256 key for the gateway's per-job lease tokens. Left empty the gateway mints one per process,
# which is only correct for a single replica and is logged as a warning.
RUNNER_JOB_TOKEN_KEY=
# Accepted credentials for CloudPool workers, comma separated. Empty means no pool worker can
# authenticate (logged at startup), which is the honest default - and note that nothing enrolls
# CloudPool runner_devices rows yet, so the pool is unreachable regardless. See docs/compute-fabric.md.
RUNNER_POOL_CREDENTIALS=
# On-demand pool (docs/pool-waker.md). Everything here is inert while COMPUTE_MODE=Local.
# Gateway: signs the short-lived node tokens (32+ characters; openssl rand -hex 32). Empty: the pool
# routes answer 503 pool_tokens_disabled and no node can be created.
RUNNER_POOL_TOKEN_KEY=
# Engine switches. POOL_WAKER_ENGINE_ENABLED lets an empty pool queue a media job for the waker to
# serve; keep it false until the waker is running and healthy. COMPUTE_CLOUD_POOL_JOB_TYPES limits what
# may go to the pool (empty = all; go-live value: video.compile,video.analyze.extract).
# COMPUTE_ORG_RUNNERS_ENABLED=false makes Fabric a pool-only switch. The pool is used only when
# MINIO_PUBLIC_ENDPOINT is a public https address (COMPUTE_REQUIRE_PUBLIC_STORAGE_FOR_POOL=false lifts that).
POOL_WAKER_ENGINE_ENABLED=false
POOL_WAKER_WAIT_SECONDS=240
COMPUTE_CLOUD_POOL_JOB_TYPES=
COMPUTE_ORG_RUNNERS_ENABLED=true
COMPUTE_REQUIRE_PUBLIC_STORAGE_FOR_POOL=true
# Waker service (CONTROL box, `--profile poolwaker`). Left empty here on purpose; see the runbook.
# It holds a read/write cloud provider token, so it never runs on the media box (which runs untrusted
# render workloads): the scaler refuses to start there (REELBOLT_ROLE=media) unless
# POOL_WAKER_ALLOW_ON_MEDIA_HOST=true. It reaches the media box's gateway over the internal TLS port
# with its own client certificate (POOL_WAKER_GATEWAY_TLS_DIR above); a plain http:// gateway URL to
# another host is refused unless RUNNER_GATEWAY_ALLOW_PLAIN_HTTP=true. The token file below lives on
# the control box only.
# POOL_INSTANCE=production
# POOL_NODE_GATEWAY_URL=wss://<app host>/runner/v1/connect
# POOL_WAKER_TOKEN_FILE=/opt/reelbolt/secrets/hcloud.token   # mode 0600, owner uid 10001
# HCLOUD_SNAPSHOT_ID=latest
# HCLOUD_FIREWALL=<id of a firewall with no inbound rules>
# Pool nodes join the private network in their own subnet (the waker picks their addresses) and dial
# ws://<ENGINE_PRIVATE_IP>:POOL_EDGE_PORT/v1/connect (the pool-edge service on the media box, profile poolwaker).
# HCLOUD_NETWORK_SUBNET=10.0.2.0/24   # must equal POOL_SUBNET below
# POOL_EDGE_PORT=8091
# Source subnet that an operator script cuts off from everything but pool-edge (both boxes).
# POOL_SUBNET=10.0.2.0/24
# POOL_MAX_NODES=2
# POOL_DAILY_SPEND_CAP_EUR=5
# Hostname the runner hello signature binds. Empty takes it from the request, which is correct
# when the gateway is reached over the compose network.
RUNNER_PUBLIC_HOST=
# Decision-model shadow mode for Colorist / MusicSupervisor: Off|Shadow (default Off). See docs/decision-models.md.
COLORIST_DECISION_GATE_MODE=Off
MUSIC_SUPERVISOR_DECISION_GATE_MODE=Off
VECTOR_QDRANT_GRPC_PORT=6334
# Hosted Qdrant (optional): set the https URL and API key together. A key with an http URL fails startup.
# VECTOR_QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
VECTOR_QDRANT_API_KEY=
VECTOR_CHUNK_SIZE_TOKENS=512
VECTOR_CHUNK_OVERLAP_TOKENS=64
VECTOR_SMALL_FILE_THRESHOLD_TOKENS=1500

# ── Sandbox Executor (runs untrusted, model-authored Remotion code) ─
# REQUIRED. Shared secret between the workflow engine and the sandbox service.
# The service refuses to start if this is empty: its API can start containers and
# read/write files, and it holds the Docker socket. Generate a fresh one with:
#   openssl rand -hex 32
SANDBOX_API_TOKEN=

# ── Import worker (parses uploaded zips and PDFs in isolation) ──────
# REQUIRED on EVERY box that runs `docker compose` against this file: the compose file marks it
# mandatory (`${IMPORT_WORKER_TOKEN:?...}`), so any `docker compose` command fails without it, the
# media box and the CONTROL_ENV_FILE / ENGINE_ENV_FILE deploy secrets included. Shared secret between
# the inference API and the import-worker service; the worker refuses to start without it. It is the
# only secret the worker holds (no database, storage or provider keys), and the worker is reachable
# only over the internal `import-net` network it shares with `inference`.
# Generate a fresh one with:
#   openssl rand -hex 32
IMPORT_WORKER_TOKEN=
# Optional tunables (defaults shown): concurrent zip/pdf extractions before the worker answers
# 503 + Retry-After, and the page cap passed to pdftotext (-l).
# IMPORT_WORKER_MAX_CONCURRENCY=2
# IMPORT_WORKER_PDF_MAX_PAGES=50

# Leave false. The sandbox docker network is then created with --internal, which
# removes its default route: sandboxed code reaches neither the internet nor the
# host gateway (and therefore none of the ports published above). Setting this to
# true is what re-enables `POST /api/v1/sandboxes/{id}/packages` (runtime
# npm install) — and simultaneously lets attacker-controlled code inside the
# sandbox talk to the network. Prefer baking dependencies into the runtime image.
SANDBOX_NETWORK_EGRESS=false

SANDBOX_TTL=1h
SANDBOX_EXEC_TIMEOUT=5m
# Ceiling on one exec's deadline; long renders are sized from the film's length up to this.
SANDBOX_EXEC_MAX_TIMEOUT=6h
# Memory cap of one sandbox container. A full Remotion render must fit in it; the engine renders with
# --concurrency=2 and a 256 MiB video-frame cache by default (Compute__Render__DefaultConcurrency,
# Compute__Render__OffthreadVideoCacheBytes on workflow-engine). See docs/sandbox-service.md "Render memory".
SANDBOX_MEMORY_LIMIT=2g
# /dev/shm per sandbox container (Chrome renders frames through it). Docker's 64 MB default holds
# fewer than two 4K frames and broke full-size renders of 4K/1440p footage. Counts against the memory limit.
SANDBOX_SHM_SIZE=1g
SANDBOX_CPU_LIMIT=2
SANDBOX_PIDS_LIMIT=256

# ── Video Editing (ffmpeg/ffprobe, runs inside workflow-engine) ─────
VIDEO_MAX_CONCURRENT_JOBS=1
# Threads each ffmpeg job uses (default 4). On an 8-core host 8 is recommended. Jobs share the cores:
# VIDEO_MAX_CONCURRENT_JOBS=2 jobs of 8 threads each compete for the same 8 cores.
VIDEO_FFMPEG_THREADS=4
VIDEO_ANALYZE_TIMEOUT_SECONDS=900
VIDEO_COMPILE_TIMEOUT_SECONDS=1800
# Largest single source video the platform edits (bytes, default 30 GiB) and its longest length (seconds, default 1 h).
# A step can only lower these. Timeouts above grow with the source, bounded by its real size, up to 6 h.
VIDEO_SOURCE_MAX_BYTES=32212254720
VIDEO_SOURCE_MAX_SECONDS=3600
# Refunded too-demanding failures an organization may have in 24 h before big clips are refused (0 disables).
VIDEO_SOURCE_MAX_TOO_DEMANDING_PER_DAY=3
# Font used by Phase 3 motion-graphics overlays (drawtext). Must exist in the workflow-engine
# image — the default matches the font-dejavu Alpine package the Dockerfile installs.
VIDEO_FONT_FILE=/usr/share/fonts/dejavu/DejaVuSans.ttf

# Host port (loopback only by default) for the local `whisper` ASR container (CPU Whisper-API-compatible
# server, used for VideoAnalyze transcription). Not consumed automatically — register it as a
# Transcription-capability inference_providers row via /admin/inference-providers to actually use it.
# The server has no authentication: keep WHISPER_BIND_ADDRESS on loopback, or set it to a private
# interface address (e.g. a Tailscale IP) only when another machine must reach it. Never 0.0.0.0 on an
# internet-reachable host.
WHISPER_PORT=9002
WHISPER_BIND_ADDRESS=127.0.0.1

# Host port (loopback only) for the local `embeddings` container (text-embeddings-inference, CPU,
# Qwen/Qwen3-Embedding-0.6B, OpenAI-compatible POST /v1/embeddings) used by semantic file search.
# Not consumed automatically — register it as an Embedding-capability inference_providers row
# (Kind OpenAICompatible, endpoint http://embeddings:80/v1) via /admin/inference-providers. See docs/embeddings.md.
EMBEDDINGS_PORT=9003
# Optional overrides: EMBEDDINGS_MODEL (default Qwen/Qwen3-Embedding-0.6B), EMBEDDINGS_IMAGE_TAG (default cpu-1.8)

# ── Decision Model Server (optional, `gpu` profile) ──────
# The `decision` compose service is gated behind the `gpu` profile and is NOT
# part of the default stack — `docker compose up` ignores it entirely. Bring it
# up with: docker compose --profile gpu up -d decision
#
# Image for that service. No upstream System-One-compatible backend publishes a
# container image (Open-Jev, vllm-jev and Kev are build-it-yourself recipes), so
# build one yourself and point DECISION_IMAGE at your tag. The default is a
# local tag rather than a registry reference on purpose: a missing image then
# fails loudly at `up` instead of pulling an unrelated backend.
DECISION_IMAGE=reelbolt-decision:local

# Host port for that container (container side is fixed at 8791). Not consumed
# automatically — register it as a Decision-capability inference_providers row
# via /api/v1/inference-providers to actually use it.
DECISION_PORT=8791

# Host interface that the publish mapping binds to, in the `decision` service's port
# mapping. The default is loopback-only and that is correct as shipped: a compose
# `ports:` entry governs HOST-side access only, and container-to-container traffic does
# not pass through it. The `decision` service joins the `reelbolt` network, so the
# Inference API and the WorkflowEngine reach it in-network at http://decision:8791 no
# matter what this binds to. A loopback-only publish therefore does not impede the
# in-network path — it is simply the most conservative publish available.
#
# Register the provider row with the BASE URL, no /v1/systemone suffix:
#
#   http://decision:8791
#
# DecisionClientFactory.BuildOpenJev uses the stored endpoint as HttpClient.BaseAddress,
# and TypeSafeDecisionClient POSTs the relative path "v1/systemone" against it — so the
# suffix is appended for you, and including it doubles the segment and 404s. The SSRF
# guard is not a constraint here either: IsDisallowedEndpoint returns early for kind
# OpenJev and skips the entire address classification, DNS lookup included, so any
# absolute http(s) URL is accepted on a Decision-capability row.
#
# Set DECISION_BIND_ADDRESS only to reach the port from the host itself (a curl health
# check) or from another machine. For off-host access the host's Tailscale IP
# (100.64.0.0/10) works, and 0.0.0.0 publishes on every
# interface (avoid it on an internet-reachable host). Neither is required for in-network use.
DECISION_BIND_ADDRESS=127.0.0.1

# ── Self-hosted ComfyUI (optional, `gpu` profile) ─────────
# The `comfyui` compose service is gated behind the `gpu` profile and is NOT part of the default
# stack. Bring it up with: docker compose --profile gpu up -d comfyui
#
# ComfyUI publishes no official container image that this repository has verified, so the image is
# operator-supplied: build or choose one, make sure it serves ComfyUI's HTTP API on 8188 and holds
# the Wan 2.2 TI2V-5B weights (wan2.2_ti2v_5B_fp16, umt5_xxl_fp8_e4m3fn_scaled, wan2.2_vae), and
# point COMFYUI_IMAGE at it. The default is a local tag so a missing image fails loudly at `up`.
COMFYUI_IMAGE=reelbolt-comfyui:local

# Loopback host port for that container (container side is fixed at 8188). Not consumed
# automatically — register it as a VideoGeneration-capability inference_providers row (Kind ComfyUI,
# endpoint http://comfyui:8188, model wan2.2-ti2v-5b-t2v) via /admin/inference-providers. It bills
# nothing; a VideoGenerate step budgets it in GPU minutes (maxGpuMinutes) under the engine's
# VideoGeneration__DailyGpuMinutes / VideoGeneration__GlobalDailyGpuMinutes caps. See
# docs/video-generation.md "Self-hosted ComfyUI".
COMFYUI_PORT=8188

# ── TLS (see docs/tls.md) ────────────────────────────────
# Leave DOMAIN empty for local development: nginx serves both http:// and a
# self-signed https:// out of the box (browsers will warn on the self-signed
# cert — that's expected, not a bug).
#
# Once you have a real domain pointed at this server's public IP:
#   1. Set DOMAIN and ACME_EMAIL below.
#   2. docker compose --profile tls up -d caddy
#   3. docker compose up -d --force-recreate nginx
#      (picks up the Let's Encrypt cert Caddy just obtained; renewals after
#      this are picked up automatically, no further steps needed)
#   4. Once you've confirmed https://<DOMAIN> works, set FORCE_HTTPS=true and
#      restart nginx to redirect http:// to https://.
DOMAIN=
ACME_EMAIL=
FORCE_HTTPS=false

# Set to true once real TLS (step 3 above) is actually serving https:// —
# browsers silently drop Secure cookies over plain http://, so leave this
# false for http://localhost development or login will stop working.
COOKIE_SECURE=false

# ── Service Ports (host-side) ────────────────────────────
APP_PORT=80
HTTPS_PORT=443
API_PORT=3000
INFERENCE_PORT=3001
MCP_PORT=3002

# ── MCP / OAuth public identities ────────────────────────
# Used ONLY to build the OAuth discovery documents the MCP server publishes
# (docs/design/mcp-oauth.md §7). The defaults match a local stack reached through
# nginx on APP_PORT. A real deployment MUST override both, or every MCP client is
# told to authenticate against localhost. Neither is read in stdio mode.
MCP_PUBLIC_URL=http://localhost/mcp
OAUTH_ISSUER_URL=http://localhost

# ── ASP.NET Environment ─────────────────────────────────
# Development = Swagger enabled | Production = Swagger disabled
ASPNETCORE_ENVIRONMENT=Development

# ── Next.js Web App Build Mode ──────────────────────────
# development = Turbopack dev server with hot reload (requires volumes)
# production  = Precompiled standalone build (optimized, no hot reload)
WEB_BUILD_TARGET=development
WEB_NODE_ENV=development

# Node inspector. Unauthenticated code execution for anyone who can reach the
# port. Bound to container-local loopback (not just the host-side port
# publish below) so nothing else on the docker network can reach it either.
# Set this to empty for any deployment that is not a developer's own machine.
WEB_NODE_OPTIONS=--inspect=127.0.0.1:9229

# Note: When using WEB_BUILD_TARGET=production:
# 1. Comment out or remove the volume mounts in docker-compose.yml web service
# 2. Set WEB_NODE_ENV=production
# 3. The app will run the optimized, precompiled standalone server

# ── Public Marketing Site (`/site`) ─────────────────────
SITE_BUILD_TARGET=development
SITE_NODE_ENV=development
# Next.js dev servers (`web` and `site`) only answer localhost by default. To open them from another
# device on your LAN or tailnet (a phone, a second laptop), list its hostname or IP here, comma
# separated, wildcards allowed (e.g. 192.168.*.*,my-laptop.local). Dev servers only; ignored by
# production builds. Empty by default.
NEXT_DEV_ALLOWED_ORIGINS=
# Canonical absolute origin. Used for canonical URLs, sitemap.xml,
# robots.txt, Open Graph and JSON-LD. Swap this one value on launch.
NEXT_PUBLIC_SITE_URL=https://reelbolt.ai
# "Start free" becomes the primary CTA only once self-serve signup is live. Leave this
# false (the default) on a build whose /app/signup is not deployed — the site then keeps its
# coming-soon state and points every CTA at /contact. Build-time: rebuild `site` after changing it.
NEXT_PUBLIC_SIGNUP_ENABLED=false
# Fallback only: the web pages ask the Go API which OAuth providers are configured. These flags are
# used when that request fails. Leave them false.
OAUTH_GOOGLE_ENABLED=false
OAUTH_GITHUB_ENABLED=false
# Google Analytics 4. Leave EMPTY to disable analytics entirely — no
# script is injected when unset. Format: G-XXXXXXXXXX
# The marketing site loads the Google tag on every page under Google Consent Mode v2: all storage
# denied (no cookie, cookieless pings only) until the visitor accepts the cookie banner; after a
# rejection the tag is not loaded at all. GA4 Enhanced measurement stays on (the policy names it).
# Also passed to the `web` app build (docker-compose build arg); the app loads GA only after the
# visitor grants cookie consent, with no ad personalization or Google signals.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Contact-form delivery is Cloudflare Email Sending, the same provider go-api uses above
# (CLOUDFLARE_EMAIL_TOKEN, CLOUDFLARE_EMAIL_ACCOUNT_ID, SMTP_FROM): the `site` container's
# route (app/api/contact/route.ts) sends through site/lib/marketing/mailer.ts. There is no separate webhook URL any more; with any of
# the three blank the form answers "Failed to deliver message" rather than accepting into the void.
# Where the marketing site's server forwards a contact-form newsletter opt-in
# (POST /api/v1/marketing/subscribe). Compose default reaches the Inference API in-network.
REELBOLT_API_URL=
# Public origin used in marketing confirm/unsubscribe links (Marketing:PublicBaseUrl).
# Empty falls back to PUBLIC_BASE_URL (CloudStorage:PublicBaseUrl).
MARKETING_PUBLIC_BASE_URL=
# Shared secret the site sends (X-ReelBolt-Site-Token) so the Inference API trusts the visitor IP
# it forwards for the per-IP subscribe cap. Generate with: openssl rand -hex 32.
# Three services read this one variable from this file: `site` sends it, `inference` checks it on the subscribe
# forward, and `nginx` checks it on a tracked-link click (/l/<code>) the site relays, to count
# that relay against its own rate limit instead of the per-address one. Empty on nginx = relayed
# clicks share the per-address limit, so on a busy day some land on the home page uncounted.
# Empty = forwarded IP never trusted.
SITE_FORWARD_TOKEN=
# Go API caps on relayed marketing mail (shared DB counters): per recipient domain, and global.
MARKETING_RELAY_PER_DOMAIN_PER_HOUR=30
MARKETING_RELAY_GLOBAL_PER_HOUR=100
# Campaigns via Brevo (docs/marketing-consent.md#campaigns-brevo). Set these in the real env only;
# BREVO_CAMPAIGN_API_KEY is a NEW key; the existing BREVO_API_KEY is not read. Both it and
# BREVO_WEBHOOK_TOKEN are SECRETS;
# the postal address and test mailbox never go in the repo.
# BREVO_CAMPAIGN_API_KEY=
# 0 means not configured (the send fails closed); never leave these empty.
# BREVO_LIST_ID=0
# BREVO_TEST_LIST_ID=0
# MARKETING_LIST_SEND_ENABLED=false
# BREVO_WEBHOOK_TOKEN=
# MARKETING_CAMPAIGNS_ENABLED=false
# Brevo contact sync (names and consent state pushed to the managed list). Default true; it only does anything
# once BREVO_CAMPAIGN_API_KEY and BREVO_LIST_ID are set, and does not need MARKETING_CAMPAIGNS_ENABLED.
# MARKETING_CONTACT_SYNC_ENABLED=true
# MARKETING_FROM_ADDRESS=
# MARKETING_TEST_RECIPIENT=
# MARKETING_CONTROLLER_NAME=
# MARKETING_FOOTER_VAT_NUMBER=IT02862070030
# MARKETING_FOOTER_ADDRESS=

# First-video grant abuse check (docs/billing.md "The first-video grant"): ipinfo.io token for VPN/proxy/hosting
# detection of the sign-up IP. A SECRET. Empty skips that check (the grant goes ahead).
# IPINFO_TOKEN=
# Recipe marketplace (docs/marketplace.md "Before switching it on"). false (default) = every marketplace route
# answers a bare 404 and no worker acts. Set true on the host only after the go-live checklist; the Inference API
# and the engine read the same value, so set it on both hosts and RECREATE both services through your normal release path (a plain restart does not re-read .env).
MARKETPLACE_ENABLED=false

# Billing (WP B9, docs/billing.md). BILLING_ENABLED=false (the self-host default) makes every
# /api/v1/billing endpoint answer 404. The Paddle values below are SECRETS (docs/secrets.md);
# PADDLE_ENVIRONMENT is `sandbox` (default) or `live`. PADDLE_TOPUP_PRICE_* are Paddle price ids
# (pri_...) for the 500/1000/3000-credit top-up packs; a blank one means that pack is not sold.
BILLING_ENABLED=false
PADDLE_API_KEY=
# The CLIENT-side (publishable) token - `test_...` in sandbox, `live_...` live. NOT a secret: the API
# serves it to the browser, which initializes Paddle.js with it for the embedded one-page checkout and
# the buyer's localized prices. It must belong to the same Paddle account as PADDLE_ENVIRONMENT. Blank
# starts no embedded checkout; the buyer completes the same transaction on Paddle's hosted page.
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_TOPUP_PRICE_500=
PADDLE_TOPUP_PRICE_1000=
PADDLE_TOPUP_PRICE_3000=
# Going live: PADDLE_ENVIRONMENT must be `live` for the live account, and the price ids, client token
# and webhook secret must ALL come from that same account. The full procedure - including reading the
# destination's `endpoint_secret_key` back exactly once, it cannot be retrieved again - is in
# docs/billing.md "Migrating from sandbox to live".
# PADDLE_WEBHOOK_IP_ALLOWLIST (default `false`) makes nginx accept only Paddle's published IPs on the
# webhook route. It only means what it should when the real client address is restored
# (REAL_IP_FROM_CLOUDFLARE=true in the cloud deployment); otherwise every request looks like Cloudflare's.
PADDLE_WEBHOOK_IP_ALLOWLIST=

# Stripe (alternative billing provider; docs/billing.md). BILLING_PROVIDER selects the provider NEW
# checkouts use: `Paddle` (default, also when blank) or `Stripe`. Existing subscriptions keep the
# provider they were bought with, so both can be configured at once. With BILLING_PROVIDER=Stripe and
# BILLING_ENABLED=true, the operator environment check requires the starred (*) values below and refuses CHANGE_ME.
# Test mode only until the live cutover: keys start `sk_test_` / `rk_test_` (live: `sk_live_` / `rk_live_`).
BILLING_PROVIDER=Paddle
# (*) SECRET. A RESTRICTED key (`rk_...`) with only the permissions the API uses is preferred over `sk_`.
STRIPE_API_KEY=
# (*) SECRET. The endpoint signing secret (`whsec_...`) of the webhook endpoint created in the Stripe
# Dashboard for https://<host>/api/v1/billing/webhooks/stripe. Create that endpoint with API version
# `2026-09-30.endive` (the version the parser expects). Sandbox and live endpoints have DIFFERENT secrets.
STRIPE_WEBHOOK_SECRET=
# SECRET, optional. The previous endpoint secret, kept during a rotation (Stripe signs with both for up to
# 24 h) so in-flight events still verify. Remove it after the rotation.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
# Stripe Managed Payments is the chosen model: Stripe is the seller of record and handles VAT and sales tax
# (`true`, the default). Product tax codes are required in the catalog (the sync tool defaults to
# `txcd_10105002`). `false` is NOT the chosen model: it would make us the seller using plain Stripe with Stripe Tax
# (`automatic_tax`), which needs tax registrations and invoicing of our own. Do not set it without a decision.
STRIPE_MANAGED_PAYMENTS=true
# Stripe API base URL. Leave the default; set it only to point at a mock (e.g. stripe-mock) in tests.
# With a live key (`sk_live_` / `rk_live_`) it MUST be exactly https://api.stripe.com (check-env and the API refuse otherwise).
STRIPE_API_BASE=https://api.stripe.com
# (*) The Billing Portal configuration id (`bpc_...`) the API passes on every portal session, so the
# portal never bypasses the platform's proration rules.
STRIPE_PORTAL_CONFIGURATION_ID=
# (*) The public https origin checkout returns to, e.g. https://app.example.com. Falls back to
# PUBLIC_BASE_URL when blank, which is http://localhost by default and so FAILS check-env: set it.
STRIPE_RETURN_BASE_URL=
# (*) One-time price ids (`price_...`) for the 500/1000/3000-credit top-up packs; a blank pack is not
# sold. Plan prices and these ids come from the `tools/stripe-catalog-sync` output: run `node tools/stripe-catalog-sync/sync.mjs` (dry run by default; add `--apply` to write).
STRIPE_TOPUP_PRICE_500=
STRIPE_TOPUP_PRICE_1000=
STRIPE_TOPUP_PRICE_3000=

# Stripe Checkout branding, sent on every checkout session (not the customer portal, invoices or emails: those
# use the Dashboard account branding). Not secrets. Each value comes from the brand tokens; blank a value (set it
# to nothing) to fall back to the Dashboard branding for it. Under Managed Payments the page is Link's: the
# brand panel follows these, the pay button keeps Link's own colour.
# Page background: brand "paper" #0B0B12 (dark, so the full-colour logo stays legible).
STRIPE_BRANDING_BACKGROUND_COLOR=#0B0B12
# Button colour: brand accent-strong #7C3AED.
STRIPE_BRANDING_BUTTON_COLOR=#7C3AED
# Corner style (pill | rectangular | rounded): rectangular, because the site uses square corners.
STRIPE_BRANDING_BORDER_STYLE=rectangular
# Stripe font token: chakra_petch, the brand heading font.
STRIPE_BRANDING_FONT_FAMILY=chakra_petch
# Business name shown on the page.
STRIPE_BRANDING_DISPLAY_NAME=ReelBolt
# Logo and icon, public https URLs served by the marketing site from /brand (rendered by
# brand/scripts/render-stripe-branding.mjs). They MUST exist at these URLs before switching to Stripe.
STRIPE_BRANDING_LOGO_URL=https://reelbolt.ai/brand/stripe-logo.png
STRIPE_BRANDING_ICON_URL=https://reelbolt.ai/brand/stripe-icon.png

# Days of nginx daily access logs kept in the nginx_logs volume (default 30). Logs never contain query strings or path tokens (redacted in nginx.conf).
NGINX_LOG_RETENTION_DAYS=30
# MODEL_CATALOG_SEED_PRICES=Apply   # model-catalog price seed on each Inference API boot: Apply (default) | DryRun (log only) | Off
# MODEL_CATALOG_SEED_PRICES_ADOPT=   # ';'-separated adopt tokens (from the DryRun log's adopt=); each lets the seed replace one unverified PLACEHOLDER row. Remove after the Apply boot
# MODEL_CATALOG_SEED_PRICES_LOG_LIMIT=200   # series action lines logged per boot; 0 = unlimited (set 0 for the DryRun review boot)

# ── Desktop runner gateway ────
# The wss:// address pairing hands a desktop runner. Every ReelBolt address lives on one host, so
# this is wss://<your host>/runner/v1/connect; nginx forwards that path to the runner gateway
# (RUNNER_GATEWAY_UPSTREAM on the control box, default http://10.0.0.3:8090). Empty: pairing is
# refused, because a runner with nowhere to connect cannot be paired.
RUNNER_GATEWAY_URL=

# ── Observability ────
# Traces and metrics from go-api, inference and workflow-engine (docs/observability.md). Export is
# OFF until the endpoint is set: with a blank endpoint no exporter is registered and startup is
# identical to a build without telemetry. Any OTLP/HTTP collector works; Grafana Cloud expects
# https://otlp-gateway-<region>.grafana.net/otlp with protocol http/protobuf. The stack must be in an EU
# region (prod-eu-*): the Privacy Policy tells people their telemetry stays in the EU region. The auth header is a
# SECRET: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instanceId:token>.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
# Becomes the deployment.environment resource attribute on every signal.
OTEL_DEPLOYMENT_ENVIRONMENT=
# The browser telemetry ingest endpoints on the Inference API (the four alpha
# funnel events and client error reports, docs/observability.md). Off by default: an unopted
# deployment answers 404 exactly as it did before. Both this and NEXT_PUBLIC_TELEMETRY_ENABLED must
# be true for the funnel to be measurable.
TELEMETRY_CLIENT_INGEST_ENABLED=false
# Anonymous POST /api/v1/telemetry/visit (the five consented visitor events: site.visit,
# site.page_view, site.cta_click, signup.started, signup.submitted); 404 when false.
# While this is false NO visitor is ever recorded, whatever people accept on the cookie banner: every
# tracked link reads 0 visitors on the admin Links page and in BI (clicks and accounts are not
# affected). The Links page says so (visitIngestEnabled in its funnel response). Turn it on to see
# visitors per link and where they stop before signup.
TELEMETRY_VISIT_INGEST_ENABLED=false
# Anonymous POST /api/v1/telemetry/csp-report: browsers' CSP/COEP violation reports, stored as daily aggregate counts (docs/csp-reporting.md). On by default; false stores nothing (the endpoint still answers 204).
TELEMETRY_CSP_REPORT_ENABLED=true
# The app-side telemetry switch for `web` (the funnel, client error reports and the consent
# surface). Off by default. A NEXT_PUBLIC_* value is inlined into the browser bundle, so a
# production web image must carry it at BUILD time; the default development target reads it from
# the environment. Nothing is collected until the person opts in.
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# ── New-user funnel (docs/design/new-user-funnel.md) ──────────────
# Tracked links (/l/<code>): count the click and redirect to the landing page. false = 404, nothing counted.
MARKETING_LINKS_ENABLED=true
# Save the campaign labels and the landing path a signup request itself carries (no cookie) on the
# new account, and let both travel through a Google or GitHub sign-in so an account created that
# way keeps them. Off = neither is recorded, and neither is sent to Google or GitHub at all.
# One variable for go-api (acts on it) and inference (reports it to the Links page).
# Privacy switch: read the Privacy text first.
ATTRIBUTION_URL_CAPTURE_ENABLED=false
# Send a brand-new account to /app/welcome (two questions, then its first project).
# false switches the two welcome questions off, and only them; the dashboard keeps its first-video
# rail. Not a rollback. Run-time (web restart).
WELCOME_FLOW_ENABLED=true
# Your own sample clips for "try it with our sample clips": public https:// links, comma or space separated, at most 8. Empty = offer hidden. Run-time (web restart).
ONBOARDING_SAMPLE_CLIP_URLS=

# ── Grafana (self-host dashboards; observability profile only) ────
# An operator Grafana that reads six versioned dashboards (operator files, not in the public
# repository). Not part of the shipped cloud deployment, which reads the same
# dashboards from Grafana Cloud over OTLP — this container is for a self-host stack, or for a
# control box pointed at the organization's hosted Prometheus/Tempo. It is never a default service;
# it starts only with the opt-in profile, `docker compose --profile observability up -d grafana`,
# and these variables are read only then. An unset variable leaves its datasource provisioned but
# unreachable, which is intended.
#
# The Postgres role must be the read-only one an operator file (not in the public repository) creates:
# dashboards 05-llm-spend and 06-refunds read usage_events and credit_ledger_entries, the billing
# ledger. GRAFANA_PROMETHEUS_TOKEN, GRAFANA_TEMPO_TOKEN and
# GRAFANA_POSTGRES_PASSWORD are SECRETS (docs/secrets.md) — never commit a value. GRAFANA_ADMIN_PASSWORD
# empty or absent leaves Grafana's built-in `admin` default in place (nothing is generated and nothing
# is logged), so set it; the loopback-only publish keeps that default off the network.
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_USER=
GRAFANA_PROMETHEUS_TOKEN=
GRAFANA_TEMPO_URL=
GRAFANA_TEMPO_USER=
GRAFANA_TEMPO_TOKEN=
GRAFANA_POSTGRES_HOST=
GRAFANA_POSTGRES_PORT=
GRAFANA_POSTGRES_DATABASE=
GRAFANA_POSTGRES_USER=
GRAFANA_POSTGRES_PASSWORD=
# Leave empty for the compose default `require`, which is what a managed database needs. Set
# `disable` only for the bundled container, which serves no TLS and stays on the private bridge network.
GRAFANA_POSTGRES_SSLMODE=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Host port for the operator UI (loopback only). Defaults to 3300: `web` already publishes 3000.
GRAFANA_PORT=

# ── Postgres backups (nightly, encrypted, off the box) ────
# infra/scripts/backup-postgres.sh dumps the control box's Postgres, packs it with the Data
# Protection ring, encrypts that with age on the host and uploads it to the backups bucket; see
# docs/postgres-backups.md. Every value is left blank on purpose: the script has a working default
# for each, and the box's /opt/reelbolt/.env carries the real ones.
PG_BACKUP_CONTAINER=
PG_BACKUP_USER=
PG_BACKUP_DB=
# rclone path of the destination bucket root; the object key is dumps/reelbolt-<ts>.tar.age.
PG_BACKUP_DEST=
# Directory holding the Data Protection ring (key-*.xml). It rides in the archive only when
# PG_BACKUP_INCLUDE_RING is true.
PG_BACKUP_KEYS_DIR=
# Off by default: bundling the ring means the one age identity unlocks both customer data and the
# provider credentials the ring protects, and a ring re-entered by hand is recoverable while the
# dump is not. Set true to carry keys/key-*.xml; with it true and no key files the run fails closed.
PG_BACKUP_INCLUDE_RING=
# The age RECIPIENT is a PUBLIC key (age1...), configuration rather than a secret: it is safe on
# the host and in this file. The matching identity (AGE-SECRET-KEY-1...) is the operator's, held in
# the password manager and on paper, and must never be placed on either host or committed.
PG_BACKUP_AGE_RECIPIENT=
PG_BACKUP_AGE_BIN=
PG_BACKUP_RCLONE_BIN=
PG_BACKUP_LOG_DIR=
# PARENT directory for the temporary work dir: the script creates it 0700 and mktemp -d picks the
# name under it (a fixed, predictable path is a symlink/race surface). Default /var/lib/reelbolt.
PG_BACKUP_WORK_DIR=
PG_BACKUP_KEEP_LOCAL=
PG_BACKUP_VERIFY=
# rclone config holding the backups-bucket remote. Its API token IS a secret (docs/secrets.md).
RCLONE_CONFIG=

# ── Content moderation (optional; docs/content-moderation.md) ──
# Master switch for the ContentModeration capability. Off by default. When true, a resolved
# ContentModeration model capability moderates generation prompts, ingest, generated text and
# publish/egress; with no resolved provider, publishing fails closed by design. Moderation is free
# at OpenAI, so there is no cost switch. Never put provider keys here: they live on the provider row.
CONTENT_MODERATION_ENABLED=false

# ── Public API (optional; scoped, capped API keys) ──
# Master switch. Off by default: API keys do not authenticate and /api/v1/org/api-keys answers 404.
PUBLIC_API_ENABLED=false
# ── Avatars (operator kill switch; docs/design/avatars.md) ──
# A consented likeness of a real person that video models can use. Avatars of people are live (the Terms and Privacy
# versions that cover avatars, objects, pictures and the workspace avatar library are published: 2026-11-17). OFF by default in this file. While
# false AND AVATAR_OBJECTS_ENABLED is false too, every /api/v1/projects/{id}/avatars route answers 404 and nothing is
# written; with either one on the routes answer, and a row of the kind that is off is treated as absent. Files already
# held by an avatar still cannot be deleted, and the retention sweep still deletes expired or revoked avatars.
# Accepted values of this switch and of AVATAR_OBJECTS_ENABLED: true or false, nothing else. Anything else (yes, 1, on)
# is read as false, is logged once at startup at Error naming the key, and never makes a request fail.
AVATARS_ENABLED=false
# Avatars of OBJECTS (a product, a vehicle, a place; docs/design/avatar-objects.md): a named set of pictures and short
# videos with no person in them, so no consent of a person, no keep-until date and no withdrawal. Its own switch, read
# by the Inference API and the workflow engine, so objects can be switched on or off apart from avatars of people.
# OFF by default. With either switch on the avatar routes answer; a row of the kind that is off is treated as
# absent. A clip that shows an object needs only this switch (AVATARS_GENERATION gates avatars of people).
AVATAR_OBJECTS_ENABLED=false
# Who may GENERATE a clip that shows a person, only while AVATARS_ENABLED=true: Off (default), PlatformAdminOnly (the
# live smoke run, before the plan feature is shown to customers; it spends real vendor money, so run it only with the
# owner's OK) or On. The workflow engine is the authority at run time; the Inference API reads the same value so a clip
# from the editor or the assistant that the engine would refuse is refused before anything is queued.
# Accepted values: Off, PlatformAdminOnly, On (letters only: a number is not accepted, so 2 is NOT On). Anything else
# (true, yes, 2) is read as Off, so clips of people stay refused; it is logged once at startup at Error, in the
# Inference API and in the workflow engine alike, naming the key and the accepted values.
AVATARS_GENERATION=Off

# --- Social publishing (YouTube Shorts, LinkedIn) ---------------------------------------------------
# Inert until a platform's id AND secret are set: it is hidden and its connect route answers 503.
# Needs PUBLIC_BASE_URL: register {PUBLIC_BASE_URL}/api/v1/social/youtube/oauth/callback and
# {PUBLIC_BASE_URL}/api/v1/social/linkedin/oauth/callback with the platform, byte for byte.
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
