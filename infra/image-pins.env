# Exact package versions of the GPL components that ship in the published container images.
# Single source of truth for infra/scripts/check-image-publish-gate.sh; the Dockerfiles carry the
# same values as ARG defaults and infra/scripts/tests/image-pins.test.sh fails if they drift.
#
# Why pinned: GPL-SOURCE-OFFER.md promises the corresponding source of the binary in the image.
# A rebuild that silently picked up a newer distro package would change the binary the offer covers.
# A pin that the distro has retired makes the image build FAIL; bump it deliberately here and in the
# Dockerfiles (see the pin table in the image publication gate script), never by loosening the check.
#
# Debian bookworm (node:26-bookworm-slim): sandbox-runtime and sandbox-executor.
FFMPEG_DEBIAN_VERSION=7:5.1.9-0+deb12u1
# Alpine 3.24 (alpine:3.24 and mcr.microsoft.com/dotnet/aspnet:10.0-alpine): worker, workflow-engine,
# inference-api (ffmpeg), import-worker (poppler-utils).
FFMPEG_ALPINE_VERSION=8.1.3-r0
POPPLER_ALPINE_VERSION=25.12.0-r1
# Remotion compositor (prebuilt FFmpeg inside the npm package @remotion/compositor-*), in the
# sandbox images. Pinned by sandbox/template/package-lock.json; must equal the "remotion" version.
REMOTION_VERSION=4.0.542
#
# NAMED EXCEPTION to "no libfdk-aac / no --enable-nonfree": Remotion's own compositor, unmodified, from
# the npm package @remotion/compositor-linux-<arch>-gnu at exactly REMOTION_VERSION. Its FFmpeg is built
# with GPL options and libfdk-aac. It is accepted only if every file below hashes to the value recorded
# here (SHA-256 of the files as published in the npm tarball, taken from the package the lockfile
# installs; the amd64 set was re-checked inside a built image). Any other ffmpeg or libavcodec with
# libfdk_aac or nonfree still fails the gate and the Dockerfile guards. Updating Remotion means
# re-recording these on purpose. Format: name=sha256, space separated.
COMPOSITOR_SHA256_LINUX_X64_GNU="ffmpeg=461169f4f3286904fbfa18212873073869b03c29ebbe99f415c50fdc7dd41113 ffprobe=3bad619e6da4abbd8fc13f46b08e869c28f38852a8a4f168579eef23b96eae1d remotion=987b641ee4a175b596da1b1fd5a46cf460471869b98c59facfa4199f2d00a1f5 libavcodec.so=c18bb207c02406639798398f8a9772e901fba2b86f2ea6ac414093168196216f libavdevice.so=1bf20339b8c1785730ae47cc31410e32beb39a6a00527a8fb14ab78b1b60c174 libavfilter.so=a0cb96a34f6884eb24741e925c0e3a6994ebe44a20fd197560e6773706f618a6 libavformat.so=491d43f55ed4c433717609ee70c7303876b8c9918c30727719c1a067c2824398 libavutil.so=6f0b2ba1381b48a0fb114689201801902db6d9540e80a5aa08493ad66089d0e5 libswresample.so=c923266ddc6f1b171b4d69b07a3e383c11faac8e530ed91dd42181cc8411de75 libswscale.so=8c6159a749905575323a15471db8ce2bbc720aebabe9b22a4aba3c42c949bb25"
COMPOSITOR_SHA256_LINUX_ARM64_GNU="ffmpeg=93cac43f6ca0c301b1ca62d120f971d9d6ee1a09a94bb655cfcc7ddc9d0cdde2 ffprobe=c54e809fd6415c7ba1e6d89c062ced0ad4434820bb89654eec36268b3f132be2 remotion=8fc227dc302f537269f709790b846386f47147ffcca073bb468158c143ff6c2a libavcodec.so=66103329cde3c265ec449878a4ac2cc244cddcf1718799c49fe15337d79363fd libavdevice.so=edf90f471cc9eb51046e23243e8fc577a6122d7ad7e38af0023a202977df7b04 libavfilter.so=1156c3ec2f0c5439581be837ba65fdf9d9cad459bf017b240caff282f26d875e libavformat.so=1f1e30cb0e6cc42b45d65f7a3d0035ec840ef5029c9e1287602cbbb36c971d3c libavutil.so=bb21137be70cf2035ba7fdb3a320bb051b15921bc6d8da155dcf8022937ca13b libswresample.so=6793a093366a89602e4cfd18f46d3d61d6bbc12ae14f718d50da1600d784fa60 libswscale.so=87e439a92103c002ea4432ce883bda2a61c0bd0d1e839769e9c1ecc3c70a11a5"
