{
  "name": "reelbolt-docs",
  "version": "0.4.0-alpha",
  "private": true,
  "description": "ReelBolt documentation site (the user guide), built from /docs/user-guide with Docusaurus.",
  "scripts": {
    "start": "docusaurus start",
    "build": "node scripts/build-all-locales.mjs",
    "postbuild": "node scripts/assert-user-guide-only.mjs && node scripts/assert-app-link.mjs && node scripts/assert-search-index.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "docs:version": "node scripts/docs-version.mjs",
    "i18n:stale": "node scripts/i18n-docs-stale.mjs",
    "i18n:test": "node --test scripts/i18n-docs-stale.test.mjs scripts/i18n-labels-check.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.3",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "tinypool": "^2.2.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
