{
  "name": "reelbolt-site",
  "version": "0.4.0-alpha",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/fetch-runner-latest.mjs && next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test \"lib/**/*.test.ts\" \"i18n/**/*.test.ts\" \"components/**/*.test.ts\"",
    "icons": "node scripts/generate-icons.mjs",
    "check:functions": "npx --yes wrangler@3.114.17 pages functions build --outdir \"${TMPDIR:-/tmp}/reelbolt-pf-check\"",
    "test:build": "node --test i18n/build-output.test.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "next": "^16.4.6",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-i18next": "^6.1.5",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
