# Server-level settings shared by the :80 (dev) and :443 server blocks.
# Rendered by docker-entrypoint.sh into /etc/nginx/conf.d/common.inc and included
# from http-server-dev.conf and https-server.conf.template.
#
# The upstream defaults are the compose service names, so a single-host stack is
# unchanged; the cloud control VM overrides UPSTREAM_WORKFLOW_ENGINE with the engine
# VM's private address (infra/compose/docker-compose.cloud.control.yml).
# CLIENT_MAX_BODY_SIZE defaults to 100M, which is also Cloudflare Free's body cap:
# see docs/tls.md "Upload size".
client_max_body_size ${CLIENT_MAX_BODY_SIZE};

set $go_api ${UPSTREAM_GO_API};
set $inference_api ${UPSTREAM_INFERENCE_API};
set $workflow_engine ${UPSTREAM_WORKFLOW_ENGINE};
set $web_app ${UPSTREAM_WEB};
set $site_app ${UPSTREAM_SITE};
set $docs_app ${UPSTREAM_DOCS};
set $caddy ${UPSTREAM_CADDY};
set $mcp ${UPSTREAM_MCP};
# Previous blue-green slot ($inference_prev, $web_prev, $site_prev): requests for something only the
# OLD release knows fall back there on 404 (locations.conf). Slots mode only, rendered by
# render-config.sh; a glob with no match is valid, so a legacy render never needs it.
include /etc/nginx/conf.d/slots-vars*.inc;

# These stay variables (per-request DNS resolution) on purpose. A static `upstream` block,
# which is what a keepalive pool needs, resolves the container name once at nginx start and
# pins that IP: a recreated go-api/inference container would be unreachable until nginx is
# restarted. Do not convert the proxy_pass targets to static upstreams without also handling
# re-resolution (`server ... resolve` with a shared zone, nginx 1.27.3+).

# Response headers for every upstream behind these server blocks (EDGE-04).
#   - X-Content-Type-Options: nosniff, always.
#   - Strict-Transport-Security only when FORCE_HTTPS=true: render-config.sh writes
#     conf.d/hsts.inc then and removes it otherwise. A glob with no match is valid, so plain-http
#     installs and an older entrypoint (which never writes the file) are unaffected.
# nginx inherits add_header from this level ONLY into a location that has no add_header of its own,
# so every location (and `if` block) in locations.conf that sets one repeats these two lines;
# nginx/tests/forwarded-headers.sh fails if one does not. Deliberately no Content-Security-Policy
# and no frame-ancestors/X-Frame-Options here: they could break embeds and need a product decision.
add_header X-Content-Type-Options "nosniff" always;
include /etc/nginx/conf.d/hsts*.inc;

# Front door for a private (staging) environment, rendered by docker-entrypoint.sh:
# empty unless BASIC_AUTH_USER and BASIC_AUTH_PASSWORD are set, otherwise `auth_basic`
# plus `auth_basic_user_file`. /health and the Paddle and Stripe webhooks opt out in locations.conf.
# See docs/staging.md.
include /etc/nginx/conf.d/basic-auth.inc;
