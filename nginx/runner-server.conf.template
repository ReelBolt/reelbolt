# runner.<domain>: the runner-gateway WebSocket endpoint (docs/runner-protocol.md).
# Rendered by docker-entrypoint.sh ONLY when UPSTREAM_RUNNER_GATEWAY is set; otherwise
# an empty file is installed and this block does not exist (the gateway is not built
# yet, D5a). Runners authenticate with a signed Ed25519 hello inside the protocol, so
# this block deliberately has NO cookie -> Authorization translation, and strips any
# Authorization header a client sends.
#
# Heartbeats are every 15 s and the gateway declares a runner dead after 45 s, so a
# 120 s idle timeout here never cuts a healthy socket (Cloudflare's own WebSocket
# idle limit is 100 s, also above 45 s).
server {
    listen 443 ssl http2;
    server_name ${RUNNER_HOSTNAME};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 1m;

    # As on the app's server blocks (common.conf.template). No location below sets an add_header.
    add_header X-Content-Type-Options "nosniff" always;
    include /etc/nginx/conf.d/hsts*.inc;

    set $runner_gateway ${UPSTREAM_RUNNER_GATEWAY};

    location = /v1/connect {
        proxy_pass $runner_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Opt-in crash reports from desktop runners (sandbox/cmd/runner-gateway/telemetry.go):
    # small JSON documents, POST only, no credential of any kind. The gateway validates,
    # logs and counts each one and stores nothing; the body cap and rate limit here are
    # the first of two.
    location = /telemetry/v1/reports {
        limit_except POST { deny all; }
        limit_req zone=runner_telemetry burst=10 nodelay;
        client_max_body_size 64k;
        proxy_pass $runner_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    location / {
        return 404;
    }
}
